# Copiar a .env (o exportar a mano) y ajustar.
# El servicio lee LAYA_CONFIG y LAYA_ACTIVE_MODEL; el resto lo usan los scripts.

# Qué modelo sirve el servicio. Debe existir en config.yaml.
#   cardiff-xlmr        clasificador HF, funciona en cualquier SO (recomendado para el demo)
#   laya-sentiment-v1   fine-tune de Laya en CoreML (macOS Apple Silicon)
#   laya-base           motor de decisión general zero-shot
LAYA_ACTIVE_MODEL=cardiff-xlmr

# Ruta al registro de modelos, si no es ./config.yaml
# LAYA_CONFIG=config.yaml

# Puerto del servicio (config.yaml también lo declara; esta variable lo pisa)
LAYA_PORT=8090

# Dónde escucha el plugin de DSH
LAYA_SERVICE_URL=http://127.0.0.1:8090

# Timeout del plugin en milisegundos. Con los modelos precargados las llamadas
# medidas van de 10 a 300 ms; el valor por defecto del plugin es 2500.
LAYA_SERVICE_TIMEOUT_MS=2500
